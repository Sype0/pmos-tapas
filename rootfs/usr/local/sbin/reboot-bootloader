#!/usr/bin/python3
# Reboot into fastboot. busybox reboot cannot pass the "bootloader" argument
# that qcom-pon turns into the PON reason ABL reads.
import ctypes
import os

os.sync()
libc = ctypes.CDLL(None, use_errno=True)
# reboot(LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2, LINUX_REBOOT_CMD_RESTART2, arg)
libc.syscall(ctypes.c_long(142), ctypes.c_long(0xfee1dead),
             ctypes.c_long(672274793), ctypes.c_long(0xa1b2c3d4),
             ctypes.c_char_p(b"bootloader"))
raise OSError(ctypes.get_errno(), "reboot failed")
