#!/usr/bin/python3
# Run a command on a pseudo-terminal, so that its stdio output is line
# buffered instead of lost in a full buffer, and append that output to a log,
# each line prefixed with the kernel's uptime.
# Usage: tapas-ptylog LOG COMMAND [ARG...]
import os
import pty
import sys


def stamp(line):
    with open('/proc/uptime') as f:
        up = f.read().split()[0]
    return b'[%s] %s\n' % (up.encode(), line.rstrip(b'\r'))


log = open(sys.argv[1], 'ab', buffering=0)
pid, fd = pty.fork()
if pid == 0:
    os.execv(sys.argv[2], sys.argv[2:])
buf = b''
while True:
    try:
        data = os.read(fd, 4096)
    except OSError:  # EIO once the command has exited
        break
    if not data:
        break
    *lines, buf = (buf + data).split(b'\n')
    for line in lines:
        log.write(stamp(line))
if buf:
    log.write(stamp(buf))
_, status = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(status))
