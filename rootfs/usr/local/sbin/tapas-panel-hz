#!/usr/bin/python3
# The display runs on what the bootloader set up, and simpledrm reports a
# made-up 60 Hz mode. Measure the panel's real refresh rate from the frame
# counter of the DPU's DSI interface (INTF_1), and print its timing. Then
# watch the DPU's INTF_1 underrun flag for N seconds (default 10;
# `tapas-panel-hz 60` while the picture breaks up): an underrun is the
# scanout not getting its pixels from DDR in time.
import ctypes
import mmap
import os
import sys
import time

INTF1 = 0x05e01000 + 0x6a800  # DPU (mdp) base + INTF_1, dpu_6_3_sm6115.h
REGS = [('timing_engine_en', 0x000), ('hsync_ctl', 0x008),
        ('vsync_period_f0', 0x010), ('vsync_pulse_width_f0', 0x018),
        ('display_v_start_f0', 0x01c), ('display_v_end_f0', 0x024),
        ('display_hctl', 0x03c), ('frame_count', 0x0ac),
        ('line_count', 0x0b0)]

page = INTF1 & ~(mmap.PAGESIZE - 1)
fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)
mm = mmap.mmap(fd, mmap.PAGESIZE, offset=page)
base = ctypes.addressof(ctypes.c_char.from_buffer(mm)) + INTF1 - page


def rd(off):
    # one 32-bit load, as the registers want
    return ctypes.c_uint32.from_address(base + off).value


for name, off in REGS:
    print('%-21s 0x%08x' % (name, rd(off)))
hsync = rd(0x008)
htotal = hsync >> 16
vtotal = rd(0x010) // htotal if htotal else 0
f0, t0 = rd(0x0ac), time.monotonic()
time.sleep(2)
f1, t1 = rd(0x0ac), time.monotonic()
hz = ((f1 - f0) & 0xffffffff) / (t1 - t0)
print('htotal %d, vtotal %d' % (htotal, vtotal))
print('refresh %.1f Hz, pixel clock %.1f MHz' % (hz, hz * htotal * vtotal / 1e6))

# MDP_TOP interrupt registers (legacy DPU layout, dpu_hw_interrupts.c):
# INTR_STATUS latches whether or not the interrupt is enabled; writing a
# bit to INTR_CLEAR clears it
TOP = 0x05e01000
INTR_STATUS, INTR_CLEAR = 0x14, 0x18
UNDERRUN, VSYNC = 1 << 26, 1 << 27  # INTF_1
mt = mmap.mmap(fd, mmap.PAGESIZE, offset=TOP & ~(mmap.PAGESIZE - 1))
tbase = ctypes.addressof(ctypes.c_char.from_buffer(mt)) + TOP % mmap.PAGESIZE


def top(off, val=None):
    r = ctypes.c_uint32.from_address(tbase + off)
    if val is not None:
        r.value = val
    return r.value


secs = float(sys.argv[1]) if len(sys.argv) > 1 else 10
print('intr_status 0x%08x' % top(INTR_STATUS))
# the vsync bit must come back within a frame, or these are not the
# registers we think they are
top(INTR_CLEAR, UNDERRUN | VSYNC)
time.sleep(0.05)
if not top(INTR_STATUS) & VSYNC:
    print('INTF_1 vsync flag never set: underrun check not valid here')
    sys.exit(0)
n = polls = 0
end = time.monotonic() + secs
while time.monotonic() < end:
    if top(INTR_STATUS) & UNDERRUN:
        n += 1
        top(INTR_CLEAR, UNDERRUN)
    polls += 1
    time.sleep(0.02)
print('underruns: seen in %d of %d polls (20 ms) over %.0f s' % (n, polls, secs))
