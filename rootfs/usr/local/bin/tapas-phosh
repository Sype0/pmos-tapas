#!/bin/bash
# Phosh for greetd's autologin. greetd swallows the session's output, so
# send it to syslog. The scale (3) is in /etc/phosh/phoc.ini, the Turkish
# keyboard in /etc/dconf/db/local.d/00-tapas.
exec > >(/usr/bin/logger -t phosh-session) 2>&1
# What a login shell would set up: musl's locale path and the launchers of
# Flatpak apps (XDG_DATA_DIRS)
for f in /etc/profile.d/*.sh; do
	[ -r "$f" ] && . "$f"
done
export LANG=tr_TR.UTF-8 LANGUAGE=tr
# The display is simpledrm, which has no render node: render on the Adreno
# (msm) and let wlroots copy to the screen
for r in /sys/class/drm/renderD*; do
	case $(readlink "$r/device/driver") in
	*/msm*) export WLR_RENDER_DRM_DEVICE=/dev/dri/${r##*/}; break ;;
	esac
done
echo "render device: ${WLR_RENDER_DRM_DEVICE:-none}"
exec /usr/bin/phosh-session
