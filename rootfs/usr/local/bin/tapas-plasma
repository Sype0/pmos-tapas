#!/bin/bash
# Plasma Mobile for greetd's autologin. greetd swallows the session's output,
# so send it to syslog.
exec > >(/usr/bin/logger -t plasma-session) 2>&1
# Settings for this phone (lock screen, no wallet, no blur, Turkish).
# startplasmamobile puts ~/.config/plasma-mobile and /etc/xdg in front of
# them.
export XDG_CONFIG_DIRS=/etc/tapas/xdg:/etc/xdg
# What a login shell would set up: musl's locale path (the language itself
# comes from ~/.config/plasma-localerc, read by startplasma) and the
# launchers of Flatpak apps (XDG_DATA_DIRS)
for f in /etc/profile.d/00locale.sh /etc/profile.d/flatpak.sh; do
	[ -r "$f" ] && . "$f"
done
# No blur at all: KWin's is off in /etc/tapas/xdg/kwinrc, the lock screen's
# in /etc/local.d/tapas-noblur.start, and here the home screens' (Folio and
# Halcyon) own wallpaper blur: wallpaperBlurEffect 0 = none, forced at every
# login.
A=$HOME/.config/plasma-org.kde.plasma.mobileshell-appletsrc
for id in $(awk -F'[][]' '/^\[Containments\]\[[0-9]+\]$/ { c = $4 }
	/^plugin=org.kde.plasma.mobile.homescreen.(folio|halcyon)$/ { print c }' "$A" 2>/dev/null); do
	kwriteconfig6 --file "$A" --group Containments --group "$id" \
		--group General --key wallpaperBlurEffect 0
done
# Which GPU KWin renders with (the display is simpledrm, the GPU is msm)
export QT_LOGGING_RULES="kwin_wayland_drm.debug=true"
exec /usr/bin/dbus-run-session /usr/bin/startplasmamobile
