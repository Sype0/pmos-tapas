#!/bin/sh
# The WCN3950 comes up with the NVM's default address, so hci_qca wants the
# bootloader's local-bd-address, which our DTB never gets: the controller
# stays unconfigured. Give it the phone's address from /etc/tapas/bdaddr
# (stock persist.vendor.service.bdroid.btmac, kept out of the repo).
A=$(cat /etc/tapas/bdaddr 2>/dev/null) || exit 0
/usr/local/sbin/tapas-bdaddr "$A" >/var/log/tapas-bdaddr.log 2>&1 &
