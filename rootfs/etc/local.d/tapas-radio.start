#!/bin/sh
# Battery/modem/Wi-Fi/Bluetooth bring-up: snapshots at 60 s and 180 s after
# boot into /var/log/tapas-radio.log (the modem takes a while to come up).
snap() {
	echo "===== t=$(cut -d' ' -f1 /proc/uptime)"
	echo "== remoteproc"
	for r in /sys/class/remoteproc/*; do
		echo "$r: $(cat $r/name) $(cat $r/state) $(cat $r/firmware)"
	done
	echo "== services"; rc-status default | grep -E 'rmtfs|tqftp|uim|modemmanager|bluetooth|networkmanager'
	echo "== power_supply"
	for p in /sys/class/power_supply/*; do echo "-- $p"; cat $p/uevent; done
	echo "== net"; ip -br link; iw dev
	echo "== rfkill"; cat /sys/class/rfkill/*/name /sys/class/rfkill/*/soft /sys/class/rfkill/*/hard 2>&1
	echo "== qrtr"; timeout 10 qrtr-lookup
	echo "== mmcli"; timeout 20 mmcli -L; timeout 20 mmcli -m any
	echo "== nmcli"; timeout 10 nmcli dev
	echo "== bluetooth"; cat /var/log/tapas-bdaddr.log; timeout 10 bluetoothctl list; timeout 10 bluetoothctl show
	echo "== display"; ls /sys/class/drm /sys/class/backlight 2>&1; cat /sys/class/drm/*/modes 2>/dev/null
	echo "== audio"; cat /proc/asound/cards; aplay -l 2>&1
	echo "== dmesg"
	dmesg | grep -E -i 'remoteproc|mpss|modem|rmtfs|qrtr|qmi|ipa|ath10k|wlan|bluetooth|hci|qca|serial|bq2589|sm5602|nopmi|power_supply|4a84000|4a8c000|firmware|vibra|msm_dpu|dsi|panel|drm|apr|q6|adsp|wcd|swr|soundwire|aw87|snd|asoc'
	echo "== logread"; logread 2>&1 | grep -E -i 'rmtfs|tqftp|uim|modem|bluetooth|wpa|NetworkManager' | tail -n 150
}
(
	sleep 60
	L=/var/log/tapas-radio.log
	[ -f $L ] && mv $L $L.prev
	snap >$L 2>&1
	sync
	sleep 120
	snap >>$L 2>&1
	sync
	# A short tone on the speaker through the UCM profile, if there is a card
	if [ -e /proc/asound/card0 ]; then
		echo "===== speaker test"
		cat /proc/asound/cards
		alsaucm -c 0 list _verbs
		alsaucm -c 0 set _verb HiFi set _enadev Speaker
		timeout 6 speaker-test -D hw:0,0 -c 2 -r 48000 -t sine -f 440 -l 1
		amixer -c 0 contents | head -n 400
		# hw:0,0 is busy if the sound server holds it: then through it
		echo "===== speaker test through the sound server"
		timeout 15 su user -s /bin/sh -c "export XDG_RUNTIME_DIR=/run/user/1000
			pactl list sinks; speaker-test -D pulse -c 2 -t sine -f 440 -l 1"
	fi >>$L 2>&1
	sync
) &
