#!/bin/sh
# Bring-up snapshot (DRM, deferred probes, i2c, input) into
# /var/log/tapas-diag.log, and a copy of the session's syslog (RAM only)
# on disk. No syncs and no rewrites without changes: the SD card is slow.
(
	sleep 30
	L=/var/log/tapas-diag.log
	[ -f $L ] && mv $L $L.prev
	{
		mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug
		echo "== uptime"; cat /proc/uptime
		echo "== cmdline"; cat /proc/cmdline
		echo "== /dev/dri"; ls -l /dev/dri /sys/class/drm
		echo "== deferred"; cat /sys/kernel/debug/devices_deferred
		echo "== i2c devices"; ls /sys/bus/i2c/devices
		echo "== input"; cat /proc/bus/input/devices
	} >$L 2>&1
	# only replace the copy when logread works: syslogd stops before us at
	# shutdown
	last=
	while :; do
		t=$(logread 2>/dev/null | tail -n 1)
		if [ -n "$t" ] && [ "$t" != "$last" ]; then
			logread >/var/log/syslog-copy.tmp 2>/dev/null &&
				mv /var/log/syslog-copy.tmp /var/log/syslog-copy.log
			last=$t
		fi
		sleep 60
	done
) &
# The panel's real refresh rate (simpledrm reports 60 Hz): this reads the
# display controller the bootloader set up
(
	sleep 270
	/usr/local/sbin/tapas-panel-hz >/var/log/tapas-panel.log 2>&1
) &
