// tapas: Plasma's Wi-Fi, mobile network, Bluetooth and power settings get
// "not authorized" from polkit, because the autologin session is not seen
// as an active local one (and Plasma's polkit agent fails to register, so
// nothing can ask for the password either). Let the phone's user (wheel) do
// these directly, including installing software from GNOME Software (Alpine
// apk through apk-polkit-rs, and Flatpak).
polkit.addRule(function(action, subject) {
	if (!subject.isInGroup("wheel"))
		return polkit.Result.NOT_HANDLED;
	var prefixes = [
		"org.freedesktop.NetworkManager.",
		"org.freedesktop.ModemManager1.",
		"org.bluez",
		"org.freedesktop.login1.",
		"org.freedesktop.timedate1.",
		"org.freedesktop.locale1.",
		"org.freedesktop.hostname1.",
		"org.freedesktop.udisks2.",
		"org.freedesktop.UPower",
		"org.freedesktop.Flatpak.",
		"org.freedesktop.packagekit.",
		"dev.Cogitri.apkPolkit",
		"org.freedesktop.fwupd.",
		"org.kde.powerdevil.",
		"org.kde.kcontrol.",
	];
	for (var i = 0; i < prefixes.length; i++)
		if (action.id.indexOf(prefixes[i]) == 0)
			return polkit.Result.YES;
	return polkit.Result.NOT_HANDLED;
});
