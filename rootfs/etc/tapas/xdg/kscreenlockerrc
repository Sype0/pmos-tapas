# postmarketOS locks Plasma Mobile right at login (/etc/xdg: LockOnStart=true),
# which defeats greetd's autologin. startplasmamobile puts /etc/xdg in front
# of this directory, so that key is locked here ([$i]). No automatic locking
# either; those two can be turned back on in the settings.
[Daemon]
Autolock=false
LockOnResume=false
LockOnStart[$i]=false
