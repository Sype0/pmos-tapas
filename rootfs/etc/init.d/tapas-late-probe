#!/sbin/openrc-run
# These probe before the root filesystem, and so /lib/firmware, is mounted:
# IPA fails its probe without ipa_fws, the Bluetooth controller's setup
# fails without its firmware, which leaves hci0 stuck in setup, and the
# remote processors fail their auto boot. Probe them again once the firmware
# is there, and start the remote processors other than the modem, which
# rmtfs starts.

description="Re-probe drivers that load firmware from the root filesystem"

depend() {
	need localmount
	after udev
	before rmtfs bluetooth
}

start() {
	ebegin "Re-probing IPA and Bluetooth, starting remote processors"
	for d in /sys/bus/platform/devices/*.ipa; do
		[ -e "$d/driver" ] || echo "${d##*/}" >/sys/bus/platform/drivers_probe
	done
	for d in /sys/bus/serial/drivers/hci_uart_qca/serial*; do
		[ -e "$d" ] || continue
		echo "${d##*/}" >/sys/bus/serial/drivers/hci_uart_qca/unbind
		echo "${d##*/}" >/sys/bus/serial/drivers/hci_uart_qca/bind
	done
	for r in /sys/class/remoteproc/remoteproc*; do
		[ -e "$r" ] || continue
		grep -q -- -mpss-pas "$r/device/modalias" && continue
		[ "$(cat "$r/state")" = offline ] && echo start >"$r/state"
	done
	eend 0
}
