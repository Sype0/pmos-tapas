#!/sbin/openrc-run
# Bring-up: ModemManager can't enable the modem ("Couldn't set operating
# mode: DeviceNotReady") because the modem leaves low-power mode for
# shutting-down and then offline on its own, seconds after it boots. Log its
# operating mode and the q6v5 interrupt counts (the "handover" one fired
# again at each change), with the kernel's uptime, from the start, to match
# the change with what else happens then (kmsg.log, rc.log, syslog).

description="Trace the modem's operating mode to /var/log/tapas-modem-trace.log"

depend() {
	before rmtfs
}

start() {
	ebegin "Tracing the modem's operating mode"
	(
		last=
		end=$(($(cut -d. -f1 /proc/uptime) + 600))
		while [ "$(cut -d. -f1 /proc/uptime)" -lt $end ]; do
			mode=$(timeout 5 qmicli -p -d qrtr://0 --dms-get-operating-mode 2>/dev/null |
				sed -n "s/.*Mode: '\(.*\)'/\1/p")
			rproc=$(cat /sys/class/remoteproc/remoteproc0/state 2>/dev/null)
			irqs=$(awk 'NR == 1 { n = NF; next } /q6v5/ {
				s = 0; for (i = 2; i <= n + 1; i++) s += $i
				printf "%s=%d ", $NF, s }' /proc/interrupts)
			now="rproc ${rproc:-?}, mode ${mode:-?}, irqs $irqs"
			if [ "$now" != "$last" ]; then
				echo "[$(cut -d' ' -f1 /proc/uptime)] $now"
				last=$now
			fi
			sleep 1
		done
	) >/var/log/tapas-modem-trace.log 2>&1 </dev/null &
	eend 0
}
