regulator: wl2866d: reset the chip at probe, don't fail on the ID

The "chip ID" this driver checks is the DVDD1 voltage register (0x03),
which only reads 0x64/0x55 straight after the chip powers up. After a warm
reboot from Android, or a rebind, it still holds the last voltage written
(0x4b seen on tapas), the probe fails with -ENODEV, no camera rail is
registered and every sensor stays deferred ("failed to get regulators").

Hold EN low for 20 ms before reading it, so the chip comes up with its
reset values, and only warn about an unexpected value: the chip answered
on I2C and every register is written right after.

--- a/drivers/regulator/wl2866d-regulator.c	2026-11-04 15:30:31.161832467 +0300
+++ b/drivers/regulator/wl2866d-regulator.c	2026-11-04 15:30:49.801832460 +0300
@@ -14,6 +14,7 @@
  *   0x03  reads 0x64 or 0x55 as chip ID
  */
 
+#include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
@@ -156,12 +157,19 @@
 		return dev_err_probe(dev, PTR_ERR(wl->regmap),
 				     "failed to init regmap\n");
 
-	/* EN pin must be high for the chip to respond on I2C */
-	wl->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_HIGH);
+	/*
+	 * EN pin must be high for the chip to respond on I2C. Hold it low
+	 * first: the "chip ID" is only the DVDD1 voltage register's reset
+	 * value, and after a warm reboot from Android (or a rebind) the chip
+	 * still has the voltage the last user set (0x4b seen on tapas).
+	 */
+	wl->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
 	if (IS_ERR(wl->enable_gpio))
 		return dev_err_probe(dev, PTR_ERR(wl->enable_gpio),
 				     "failed to get enable gpio\n");
 
+	msleep(20);
+	gpiod_set_value_cansleep(wl->enable_gpio, 1);
 	usleep_range(2000, 3000);
 
 	/* Chip ID: reads 0x64 or 0x55 from DVDD1 register before any write */
@@ -169,9 +177,9 @@
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to read chip ID\n");
 
+	/* It answered on I2C, and all registers get written below */
 	if (id != 0x64 && id != 0x55)
-		return dev_err_probe(dev, -ENODEV,
-				     "unexpected chip ID 0x%02x\n", id);
+		dev_warn(dev, "unexpected chip ID 0x%02x, continuing\n", id);
 
 	/* Set default voltages matching downstream init sequence */
 	regmap_write(wl->regmap, WL2866D_REG_DVDD1_VOLT, 0x64); /* 1200 mV */
