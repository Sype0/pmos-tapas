// SPDX-License-Identifier: GPL-2.0-only
/*
 * Xiaomi Redmi Note 12 4G (tapas), SM6225 "Khaje".
 *
 * Built on the sm6225.dtsi of the sm6225-mainline kernel
 * (https://gitlab.postmarketos.org/sm6225-mainline), laid out like its
 * Redmi Note 11 (spes) board file, which shares most of the tapas board:
 * same PMIC, charger, Type-C controller and I2C buses.
 *
 * Display is the framebuffer the bootloader leaves on (no panel driver).
 * The bootloader does not see this DTB (shim/start.S passes it), so it does
 * not fill in the memory node either: the layout below is the one ABL
 * reports on the 6 GB model.
 */
/dts-v1/;
#include "sm6225.dtsi"
#include "pm6125.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/linux-event-codes.h>

/delete-node/ &{/memory@80000000};

/ {
	model = "Xiaomi Redmi Note 12 4G";
	compatible = "xiaomi,tapas", "qcom,sm6225";
	chassis-type = "handset";

	qcom,msm-id = <0x206 0x10000>;
	qcom,board-id = <0x20022 0x00>;

	/* ABL's "RAM Partitions" on the 6 GB tapas */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x3cc00000>,
		      <0x0 0x80000000 0x0 0x40000000>,
		      <0x0 0xc0000000 0x1 0x00000000>;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "framebuffer0";

		/* 1080x2400, 32 bpp: the splash buffer the bootloader scans out */
		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x5c000000 0x0 (2400 * 1080 * 4)>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_up_n>;

		key-volume-up {
			label = "Volume Up";
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};
	};
};

&reserved_memory {
	/*
	 * Same place and layout as the stock kernel, so the log of a boot
	 * that died can be read from Android or recovery afterwards.
	 */
	ramoops@5d000000 {
		compatible = "ramoops";
		reg = <0x0 0x5d000000 0x0 0x200000>;
		record-size = <0x40000>;
		pmsg-size = <0x100000>;
		console-size = <0x80000>;
		no-map;
	};
};

/*
 * Leave the display clocks as the bootloader set them: dispcc reprograms
 * its PLL when it probes, which broke the splash scanout under the
 * framebuffer (grey screen, blue stripes). The MDSS is disabled anyway.
 */
&dispcc {
	status = "disabled";
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&gpi_dma0 {
	status = "okay";
};

/* Touchscreen: FocalTech FT5452 (chip id 0x5452), pins as in stock */
&i2c2 {
	/*
	 * geni_i2c rejects the SE core clock unless it is exactly 19.2 or
	 * 32 MHz ("Unsupported SE source clock", -EINVAL): GCC_QUPV3_WRAP0_S2_CLK
	 * has no default rate here, so the i2c2 bus never probes and the
	 * touchscreen is dead. Pin the RCG to XO 19.2 MHz.
	 */
	assigned-clocks = <&gcc GCC_QUPV3_WRAP0_S2_CLK>;
	assigned-clock-rates = <19200000>;
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,fts";
		reg = <0x38>;
		interrupt-parent = <&tlmm>;
		interrupts = <80 IRQ_TYPE_EDGE_FALLING>;
		focaltech,irq-gpio = <&tlmm 80 IRQ_TYPE_EDGE_FALLING>;
		focaltech,reset-gpio = <&tlmm 86 GPIO_ACTIVE_LOW>;
		focaltech,avdd-gpio = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		/* the firmware reports 10x the panel resolution */
		focaltech,display-coords = <0 0 10799 23999>;
		focaltech,max-touch-number = <10>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		vcc_i2c-supply = <&pm6125_l9>;
	};
};

&pm6125_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio5";
		function = "normal";
		power-source = <0>;
		bias-pull-up;
		input-enable;
	};
};

&pm6125_rtc {
	status = "okay";
};

/* Ranges from the stock tapas device tree */
&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		pm6125_s6: s6 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <1419000>;
		};

		pm6125_s7: s7 {
			regulator-min-microvolt = <1569000>;
			regulator-max-microvolt = <2040000>;
		};

		pm6125_s8: s8 {
			regulator-min-microvolt = <1060000>;
			regulator-max-microvolt = <1170000>;
		};

		pm6125_l1: l1 {
			regulator-min-microvolt = <950000>;
			regulator-max-microvolt = <1150000>;
		};

		/* UFS and USB PHYs */
		pm6125_l4: l4 {
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
		};

		/* SD card I/O; SDHCI breaks if it is ever turned off (spes) */
		pm6125_l5: l5 {
			regulator-min-microvolt = <1648000>;
			regulator-max-microvolt = <3200000>;
			regulator-allow-set-load;
			regulator-always-on;
		};

		pm6125_l6: l6 {
			regulator-min-microvolt = <570000>;
			regulator-max-microvolt = <650000>;
		};

		/* SD card I/O bias (stock vdd-io-bias-supply), 1.256V */
		pm6125_l7: l7 {
			regulator-min-microvolt = <1256000>;
			regulator-max-microvolt = <1256000>;
			regulator-always-on;
		};

		pm6125_l8: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		pm6125_l9: l9 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2000000>;
			regulator-always-on;
		};

		pm6125_l10: l10 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		/* UFS VCCQ2 */
		pm6125_l11: l11 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-allow-set-load;
		};

		/* USB PHY PLL */
		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l13: l13 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l14: l14 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		/* USB PHY D+/D- */
		pm6125_l15: l15 {
			regulator-min-microvolt = <3104000>;
			regulator-max-microvolt = <3232000>;
		};

		pm6125_l16: l16 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l17: l17 {
			regulator-min-microvolt = <1220000>;
			regulator-max-microvolt = <1304000>;
		};

		/* UFS PHY PLL and reference clock */
		pm6125_l18: l18 {
			regulator-min-microvolt = <1232000>;
			regulator-max-microvolt = <1232000>;
		};

		pm6125_l19: l19 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l20: l20 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l21: l21 {
			regulator-min-microvolt = <1600000>;
			regulator-max-microvolt = <3544000>;
		};

		/* SD card */
		pm6125_l22: l22 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <3300000>;
			regulator-allow-set-load;
		};

		pm6125_l23: l23 {
			regulator-min-microvolt = <3296000>;
			regulator-max-microvolt = <3304000>;
			regulator-always-on;
		};

		/* UFS VCC */
		pm6125_l24: l24 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2960000>;
			regulator-allow-set-load;
		};
	};
};

&qupv3_id_0 {
	status = "okay";
};

&tlmm {
	ts_int_active: ts-int-active-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_int_suspend: ts-int-suspend-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	ts_reset_active: ts-reset-active-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_reset_suspend: ts-reset-suspend-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&ufs_mem_hc {
	vcc-supply = <&pm6125_l24>;
	vcc-max-microamp = <800000>;
	vccq2-supply = <&pm6125_l11>;
	vccq2-max-microamp = <800000>;
	vdd-hba-supply = <&pm6125_l18>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&pm6125_l4>;
	vdda-phy-max-microamp = <85700>;
	vdda-pll-supply = <&pm6125_l18>;
	vdda-pll-max-microamp = <18300>;
	status = "okay";
};

/* Card detect (gpio88) is left out: a card must be inserted at boot */
&sdhc_2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_state_on>;
	pinctrl-1 = <&sdc2_state_off>;

	vmmc-supply = <&pm6125_l22>;
	vqmmc-supply = <&pm6125_l5>;

	/* sm6225.dtsi leaves bus-width out, and UHS-I needs 4 bits */
	bus-width = <4>;
	no-sdio;
	no-mmc;
	/* Stock qcom,dll-hsr-list */
	qcom,ddr-config = <0x80040868>;
	/*
	 * SDR104 tuning always fails (-5) on mainline, while Android runs the
	 * same card at SDR104. Stay at 3.3 V high speed, which needs no tuning.
	 */
	no-1-8-v;

	broken-cd;
	status = "okay";
};

&usb {
	qcom,select-utmi-as-pipe-clk;
	status = "okay";
};

/* Peripheral only for now: the bring-up shell is a USB gadget */
&usb_dwc3 {
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	dr_mode = "peripheral";
};

&usb_hsphy {
	vdd-supply = <&pm6125_l4>;
	vdda-pll-supply = <&pm6125_l12>;
	vdda-phy-dpdm-supply = <&pm6125_l15>;
	status = "okay";
};

/*
 * GPU: Adreno 610 (a610, chipid 0x06010001). No real GMU -> the mainline
 * "gmu-wrapper"; gpucc (qcom,sm6225-gpucc) and gmu_wrapper are already okay
 * in sm6225.dtsi, only the gpu and its SMMU are disabled. drm/msm (DRM_MSM=y)
 * and CONFIG_SM_GPUCC_6225=y are in the base config. The zap region
 * pil_gpu_mem (0x56615000, no-map) is reserved in sm6225.dtsi.
 *
 * Firmware (put in the rootfs /lib/firmware/qcom/, pulled from the stock
 * /vendor/firmware): a630_sqe.fw and the split zap a610_zap.mdt + .b00..b02.
 */
&adreno_smmu {
	status = "okay";
};

&gpu {
	status = "okay";
};
