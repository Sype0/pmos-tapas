// SPDX-License-Identifier: GPL-2.0-only
/*
 * Xiaomi Redmi Note 12 4G (tapas), SM6225 "Khaje".
 *
 * Built on the sm6225.dtsi of the Redmi 10C (fog) mainline port by
 * Damir00109 (https://github.com/Damir00109/Redmi10c), which shares the SoC
 * wiring of tapas: UFS rails and reset, SD card rails, volume keys and
 * USB PHY are the same in the stock tapas device tree.
 *
 * Display is the framebuffer the bootloader leaves on (no panel driver).
 * Board ids and memory regions come from the stock tapas device tree.
 */
/dts-v1/;
#include "sm6225.dtsi"
#include "pm6125.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

/ {
	/* KHAJE, tapas: the bootloader picks the DTB by these */
	qcom,msm-id = <0x206 0x10000>;
	qcom,board-id = <0x20022 0x00>;
	model = "Xiaomi Redmi Note 12 4G";
	compatible = "xiaomi,tapas", "qcom,sm6225";
	chassis-type = "handset";

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_up_default>;

		key-volume-up {
			label = "volume_up";
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <10>;
		};
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "framebuffer0";

		/* 1080x2400, 32 bpp: the splash buffer the bootloader scans out */
		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0 0x5c000000 0 (2400 * 1080 * 4)>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Same place and layout as the stock kernel, so the log of a boot
	 * that died can be read from Android or recovery afterwards.
	 */
	/delete-node/ ramoops@9ff00000;

	ramoops@5d000000 {
		compatible = "ramoops";
		reg = <0x0 0x5d000000 0x0 0x200000>;
		record-size = <0x40000>;
		pmsg-size = <0x100000>;
		console-size = <0x80000>;
	};
};

/delete-node/ &ramoops_mem;

&reserved_memory {
	ramoops_region: memory@5d000000 {
		reg = <0x0 0x5d000000 0x0 0x200000>;
		no-map;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pm6125_gpios {
	status = "okay";

	vol_up_default: vol-up-default-state {
		pins = "gpio5";
		function = "normal";
		input-enable;
		bias-pull-up;
	};
};

&pm6125_rtc {
	status = "okay";
};

&pm6125_temp {
	status = "okay";
};

/*
 * Ranges from the stock tapas device tree. The UFS rails are fixed to the
 * values the fog port runs UFS with; all of them are inside the stock
 * tapas ranges.
 */
&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		pm6125_s6a: s6 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <1419000>;
		};

		pm6125_s7a: s7 {
			regulator-min-microvolt = <1569000>;
			regulator-max-microvolt = <2040000>;
		};

		pm6125_s8a: s8 {
			regulator-min-microvolt = <1060000>;
			regulator-max-microvolt = <1170000>;
		};

		pm6125_l1a: l1 {
			regulator-min-microvolt = <950000>;
			regulator-max-microvolt = <1150000>;
		};

		/* UFS PHY */
		pm6125_l4a: l4 {
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
		};

		/* SD card I/O */
		pm6125_l5a: l5 {
			regulator-min-microvolt = <1650000>;
			regulator-max-microvolt = <3050000>;
			regulator-allow-set-load;
		};

		pm6125_l6a: l6 {
			regulator-min-microvolt = <570000>;
			regulator-max-microvolt = <650000>;
		};

		pm6125_l7a: l7 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l8a: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		pm6125_l9a: l9 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2000000>;
			regulator-always-on;
		};

		pm6125_l10a: l10 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		/* UFS VCCQ2 */
		pm6125_l11a: l11 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-allow-set-load;
		};

		pm6125_l12a: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l13a: l13 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l14a: l14 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l15a: l15 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l16a: l16 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l17a: l17 {
			regulator-min-microvolt = <1220000>;
			regulator-max-microvolt = <1304000>;
		};

		/* UFS PHY PLL and reference clock */
		pm6125_l18a: l18 {
			regulator-min-microvolt = <1232000>;
			regulator-max-microvolt = <1232000>;
		};

		pm6125_l19a: l19 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l20a: l20 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l21a: l21 {
			regulator-min-microvolt = <1600000>;
			regulator-max-microvolt = <3544000>;
		};

		/* SD card */
		pm6125_l22a: l22 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <3300000>;
			regulator-allow-set-load;
		};

		pm6125_l23a: l23 {
			regulator-min-microvolt = <3296000>;
			regulator-max-microvolt = <3304000>;
			regulator-always-on;
		};

		/* UFS VCC */
		pm6125_l24a: l24 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2960000>;
			regulator-allow-set-load;
		};
	};
};

&tlmm {
	/* UFS_RESET is pin 120 in pinctrl-khaje (113 in the stock tree) */
	gpio-ranges = <&tlmm 0 0 121>;

	ufs_reset_default: ufs-reset-default-state {
		config {
			pins = "ufs_reset";
			bias-pull-down;
			drive-strength = <8>;
			output-high;
		};
	};
};

&ufs_mem_hc {
	vcc-supply = <&pm6125_l24a>;
	vccq2-supply = <&pm6125_l11a>;
	vcc-max-microamp = <800000>;
	vccq2-max-microamp = <800000>;
	qcom,vddp-ref-clk-supply = <&pm6125_l18a>;
	qcom,vddp-ref-clk-min-uV = <1232000>;
	qcom,vddp-ref-clk-max-uV = <1232000>;
	qcom,vddp-ref-clk-max-microamp = <100>;
	qcom,force-legacy-dme-quirks;
	qcom,disable-devfreq;
	qcom,auto-hibern8-us = <5000>;

	pinctrl-names = "default";
	pinctrl-0 = <&ufs_reset_default>;
	reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&pm6125_l4a>;
	vdda-phy-max-microamp = <85700>;
	vdda-pll-supply = <&pm6125_l18a>;
	vdda-pll-max-microamp = <18300>;
	status = "okay";
};

/* Card detect (gpio88) is left out like on fog: a card must be inserted */
&sdhc_2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_state_on>;
	pinctrl-1 = <&sdc2_state_off>;

	vmmc-supply = <&pm6125_l22a>;
	vqmmc-supply = <&pm6125_l5a>;

	bus-width = <4>;
	broken-cd;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
	sd-uhs-sdr104;
	max-frequency = <202000000>;

	status = "okay";
};
