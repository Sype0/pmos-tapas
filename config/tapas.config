# Changes on top of base.config (the sm6225-mainline pmaports config)
CONFIG_LOCALVERSION="-tapas"
# CONFIG_LOCALVERSION_AUTO is not set

# The bootloader's command line never reaches the kernel (the shim passes
# our DTB), so this is the command line, unless a DTB variant sets
# chosen/bootargs (tapas-display does, for one DRM device).
# printk.devkmsg=on: the init's lines must not be rate limited away.
# msm.separate_gpu_kms=1: no MDSS yet, so the GPU must be its own DRM device
# (otherwise adreno waits forever for a display component master).
CONFIG_CMDLINE="console=tty0 consoleblank=0 loglevel=7 printk.devkmsg=on log_buf_len=2M clk_ignore_unused pd_ignore_unused fw_devlink=off deferred_probe_timeout=120 msm.separate_gpu_kms=1 rcupdate.rcu_cpu_stall_suppress=1"
CONFIG_CMDLINE_FROM_BOOTLOADER=y

# ABL drops the boot image's ramdisk, so the initramfs is built in
# (CONFIG_INITRAMFS_SOURCE is added by scripts/build.sh)

# Built in, the bring-up initramfs has no modules: kernel log kept over a
# warm reset, reboot through the PMIC
CONFIG_PSTORE_RAM=y
CONFIG_POWER_RESET_QCOM_PON=y

# Faster CI builds; nothing here reads the debug info
CONFIG_DEBUG_INFO_NONE=y

# Android partitions and SD cards
CONFIG_F2FS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# Radios: Bluetooth on uart3 and IPA (mobile data) are modules in the base
# config, and the rootfs has no modules
CONFIG_BT_HCIUART=y
CONFIG_QCOM_IPA=y
CONFIG_RMNET=y

# Bluetooth profiles, all off in the base config: headsets (HFP/HSP) and
# serial ports run over RFCOMM, tethering over BNEP, keyboards over HIDP or
# (LE) UHID; bluetoothd does its LE crypto through AF_ALG
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
CONFIG_UHID=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# Battery: spes charger stack (SM5602 fuel gauge + nopmi charger policy)
CONFIG_FUEL_GAUGE_SM5602=y
CONFIG_NOPMI_CHARGER=y

# Display: the stock 120 Hz DSC AMOLED panel (kernel/drivers/gpu/drm/panel)
CONFIG_DRM_PANEL_XIAOMI_M7_38_0C_0A=y

# Vibration motor on a PMIC GPIO
CONFIG_INPUT_GPIO_VIBRA=y

# Flatpak: FUSE for xdg-document-portal (file access from sandboxed apps);
# the rootfs has no kernel modules, so built in
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
