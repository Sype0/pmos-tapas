# Changes on top of base.config (the working Redmi 10C config)
CONFIG_LOCALVERSION="-tapas"
# CONFIG_LOCALVERSION_AUTO is not set

# The bootloader's command line is ignored; this is the whole of it.
# printk.devkmsg=on: the init's lines must not be rate limited away.
CONFIG_CMDLINE="console=tty0 consoleblank=0 loglevel=7 printk.devkmsg=on log_buf_len=2M clk_ignore_unused pd_ignore_unused fw_devlink=off deferred_probe_timeout=120 panic=0 nmi_watchdog=0 rcupdate.rcu_cpu_stall_suppress=1"
CONFIG_CMDLINE_FORCE=y

# Android partitions and SD cards
CONFIG_F2FS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
